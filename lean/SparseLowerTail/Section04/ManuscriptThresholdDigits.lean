  have hu := Real.log_le_log hz0 hz.2
  have hll := digit_log_z_upper.1
  have hlu := digit_log_z_lower.2
  norm_num [digitZLower, digitZUpper] at hl hu
  rw [branchLog_eq_neg_log]
  constructor <;> linarith

