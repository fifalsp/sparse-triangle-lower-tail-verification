/-- Every cell vertex is the apex or one of the thirty-six exact non-apex jobs. -/
theorem cellVertex_eq_apex_or_job (i : Fin 12) (v : ℝ×ℝ)
    (hv : v∈cellVertices i) :
    v=criticalPoint ∨ ∃ j : Fin 36,nonapexCell j=i ∧ nonapexVertex j=v := by
  fin_cases i
  · change v∈cellVertices 0 at hv
    rw [cellVertices0_eq] at hv
    simp only [Finset.mem_insert,Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl
    · exact Or.inl rfl
