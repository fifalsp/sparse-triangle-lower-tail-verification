/-! Full geometric part of the twelve-cell critical certificate: the actual
curved critical region is contained in the union of the exact cell hulls.
The nonlinear certificate positivity on those hulls remains separate. -/
noncomputable section
open Set
namespace SparseLowerTail.Section05.CoverGeometry

private theorem lower_bound_glue {a b c target : ℝ}
    (hl : ∀ m∈Icc a b,target<criticalFB1 m)
    (hr : ∀ m∈Icc b c,target<criticalFB1 m) :
    ∀ m∈Icc a c,target<criticalFB1 m := by
  intro m hm
  rcases le_total m b with hb | hb
  · exact hl m ⟨hm.1,hb⟩
  · exact hr m ⟨hb,hm.2⟩

theorem criticalFB1_enclosure_0 {m : ℝ} (hm : m∈Icc (1091/5000:ℝ) (1093/5000:ℝ)) :
    (4627799/10000000:ℝ)<criticalFB1 m := by
  exact (lower_bound_glue (b := (4369/20000:ℝ))
      (lower_bound_glue (b := (2183/10000:ℝ))
      (fun _ hm => enclosureLeaf_0_0 hm)
      (lower_bound_glue (b := (273/1250:ℝ))
      (fun _ hm => enclosureLeaf_0_1 hm)
      (fun _ hm => enclosureLeaf_0_2 hm)))
      (lower_bound_glue (b := (437/2000:ℝ))
      (fun _ hm => enclosureLeaf_0_3 hm)
      (lower_bound_glue (b := (4371/20000:ℝ))
      (fun _ hm => enclosureLeaf_0_4 hm)
      (fun _ hm => enclosureLeaf_0_5 hm)))) m hm

