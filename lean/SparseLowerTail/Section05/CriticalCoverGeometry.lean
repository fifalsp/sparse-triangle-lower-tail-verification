/-- The exact curved region lies in the two outward decimal rectangles. -/
theorem criticalRegion_subset_outerBoxes : criticalRegion⊆outerBoxes := by
  intro p hp
  have hmlo : (2182/10000:ℝ)≤p.1 := criticalMeanLower_ge_2182.trans hp.1.1
  have hmhi : p.1≤(5095/10000:ℝ) := hp.1.2.trans criticalMeanUpper_le_5095
  have hFhi : p.2≤(4627799/10000000:ℝ) := hp.2.2.trans criticalPoint_box.2.2.2
  have hmstart : (2186/10000:ℝ)≤p.1 := by
    by_contra hn
    have hh := criticalFB1_enclosure_0 (m := p.1) (by constructor <;> linarith)
    linarith [hp.2.1]
  by_cases hm : p.1≤(3301/10000:ℝ)
  · left
    refine ⟨⟨hmstart,hm⟩,?_,hFhi⟩
    exact (criticalFB1_enclosure_1 (m := p.1) (by constructor <;> linarith)).le.trans hp.2.1
  · right
    have hmm : (3301/10000:ℝ)≤p.1 := (lt_of_not_ge hm).le
    refine ⟨⟨hmm,hmhi⟩,?_,hFhi⟩
    have hh := criticalFB1_enclosure_2 (m := p.1) (by constructor <;> linarith)
    linarith [hp.2.1]

/-- Complete geometric coverage by the actual twelve exact convex hulls. -/
theorem criticalRegion_covered {p : ℝ × ℝ} (hp : p∈criticalRegion) :
    ∃ i : Fin 12,p∈cellRegion i :=
  outerBoxes_below_apex_covered (criticalRegion_subset_outerBoxes hp) hp.2.2

/-- Plug this geometry into certificate cells whose vertices are the exact data.
The coefficient and positivity checks are independent of this theorem. -/
theorem covers_of_vertices (cells : Fin 12 → CertificateCell)
    (hvertices : ∀ i,(cells i).vertices=cellVertices i) :
    ∀ p∈criticalRegion,∃ i,p∈(cells i).region := by
  intro p hp
  obtain ⟨i,hi⟩ := criticalRegion_covered hp
  refine ⟨i,?_⟩
  simpa only [CertificateCell.region,hvertices i] using hi

end SparseLowerTail.Section05.CoverGeometry
