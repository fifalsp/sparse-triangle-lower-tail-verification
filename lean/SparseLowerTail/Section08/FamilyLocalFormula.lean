def familySegment (p v : FamilyVector) (s : ℝ) : FamilyVector := fun i => p i+s*v i

theorem familyVariables_segment_deriv (z : ℝ) (p v : FamilyVector) (s : ℝ) (i : Fin 13) :
    HasDerivAt (fun t => familyVariables z (familySegment p v t) i)
      (v 0*(familyPartials 0 i).realEval (familyVariables z (familySegment p v s))+
       v 1*(familyPartials 1 i).realEval (familyVariables z (familySegment p v s))+
       v 2*(familyPartials 2 i).realEval (familyVariables z (familySegment p v s))) s := by
  have hq (j : Fin 3) : HasDerivAt (fun t => p j+t*v j) (v j) s := by
    simpa using ((hasDerivAt_id s).mul_const (v j)).const_add (p j)
  have he (j : Fin 3) : HasDerivAt (fun t => Real.exp (-(p j+t*v j)))
      (-v j*Real.exp (-(p j+s*v j))) s := by
    simpa only [Pi.neg_apply, mul_comm] using (hq j).neg.exp
  fin_cases i
  · change HasDerivAt (fun t => p 0+t*v 0) (v 0*((1 : ℚ) : ℝ)+v 1*((0 : ℚ) : ℝ)+v 2*((0 : ℚ) : ℝ)) s
    simpa only [Rat.cast_zero, Rat.cast_one, mul_zero, mul_one, zero_add, add_zero] using hq 0
  · change HasDerivAt (fun t => p 1+t*v 1) (v 0*((0 : ℚ) : ℝ)+v 1*((1 : ℚ) : ℝ)+v 2*((0 : ℚ) : ℝ)) s
