import SparseLowerTail.Section08.CertificateTail
import SparseLowerTail.Numerics.IntervalTaylorAxes

/-! Reified logarithmic family certificate and its actual directional
first/second derivatives. The explicit Hessian is `appA3:hessian`. -/
noncomputable section
namespace SparseLowerTail.Certificate
open Section04 Numerics PolynomialExpr

abbrev FamilyVector := Fin 3 → ℝ

def familyPhi (z : ℝ) (q : FamilyVector) : ℝ := phi z (q 0) (q 1) (q 2)

/-- q₁,q₂,q₃,x₁,x₂,x₃,c₀,c₁,c₂,c₃,c₄,μc₃,A. -/
def familyVariables (z : ℝ) (q : FamilyVector) : Fin 13 → ℝ :=
  ![q 0,q 1,q 2,Real.exp (-q 0),Real.exp (-q 1),Real.exp (-q 2),
    c0 z,c1 z,c2 z,c3 z,c4 z,branchMu z*c3 z,branchMu z*c4 z]

def familyPhiExpr : PolynomialExpr 13 :=
  (.add (.add (.add (.add (.add (.add (.mul (rational 3) (var 6)) (.mul (var 7) (.add (.add (var 3) (var 4)) (var 5)))) (.neg (.mul (var 8) (.add (.add (.mul (var 0) (var 3)) (.mul (var 1) (var 4))) (.mul (var 2) (var 5)))))) (.neg (.mul (var 9) (.add (.add (var 0) (var 1)) (var 2))))) (.mul (var 10) (.add (.add (.mul (.mul (var 0) (var 0)) (var 3)) (.mul (.mul (var 1) (var 1)) (var 4))) (.mul (.mul (var 2) (var 2)) (var 5))))) (.mul (var 11) (.add (.add (.mul (var 3) (var 4)) (.mul (var 4) (var 5))) (.mul (var 5) (var 3))))) (.mul (.mul (.mul (var 3) (var 4)) (var 5)) (.add (rational 1) (.neg (.mul (var 12) (.add (.add (var 0) (var 1)) (var 2)))))))

/-- Primitive partial derivatives in the reified variable representation. -/
def familyPartials : Fin 3 → Fin 13 → PolynomialExpr 13 :=
  ![![(rational 1),(rational 0),(rational 0),(.neg (var 3)),(rational 0),(rational 0),(rational 0),(rational 0),(rational 0),(rational 0),(rational 0),(rational 0),(rational 0)],![(rational 0),(rational 1),(rational 0),(rational 0),(.neg (var 4)),(rational 0),(rational 0),(rational 0),(rational 0),(rational 0),(rational 0),(rational 0),(rational 0)],![(rational 0),(rational 0),(rational 1),(rational 0),(rational 0),(.neg (var 5)),(rational 0),(rational 0),(rational 0),(rational 0),(rational 0),(rational 0),(rational 0)]]

theorem familyPhiExpr_eval (z : ℝ) (q : FamilyVector) :
    familyPhiExpr.realEval (familyVariables z q)=familyPhi z q := by
  rw [familyPhi,phi_formula]
  simp only [familyPhiExpr,realEval,familyVariables,logPotential,Matrix.cons_val]
  norm_num
  ring

def familyGradient (z : ℝ) (q : FamilyVector) (i : Fin 3) : ℝ :=
  (familyPhiExpr.along (familyPartials i)).realEval (familyVariables z q)

def familyHessian (z : ℝ) (q : FamilyVector) (i j : Fin 3) : ℝ :=
  ((familyPhiExpr.along (familyPartials i)).along (familyPartials j)).realEval
    (familyVariables z q)

/-- The common rank-one term G in the Hessian formula. -/
def familyHessianCommon (z : ℝ) (q : FamilyVector) : ℝ :=
  Real.exp (-q 0)*Real.exp (-q 1)*Real.exp (-q 2)*
    (1+2*branchMu z*c4 z-branchMu z*c4 z*(q 0+q 1+q 2))

def familyHessianDiagonal (z : ℝ) (q : FamilyVector) (i : Fin 3) : ℝ :=
  Real.exp (-q i)*(c1 z+c2 z*(2-q i)+c4 z*((q i)^2-4*q i+2))+
    branchMu z*c3 z*Real.exp (-q i)*
      (Real.exp (-q 0)+Real.exp (-q 1)+Real.exp (-q 2)-Real.exp (-q i))+
    familyHessianCommon z q

def familyHessianOffDiagonal (z : ℝ) (q : FamilyVector) (i j : Fin 3) : ℝ :=
  branchMu z*c3 z*Real.exp (-q i)*Real.exp (-q j)+familyHessianCommon z q

