/-- First derivative along the actual logarithmic coordinate segment. -/
theorem familyPhi_segment_deriv (z : ℝ) (p v : FamilyVector) (s : ℝ) :
    HasDerivAt (fun t => familyPhi z (familySegment p v t))
      (sumThree (fun i => v i*familyGradient z (familySegment p v s) i)) s := by
  have h := familyPhiExpr.hasDerivAt_three familyPartials v
    (familyVariables_segment_deriv z p v s)
  simpa only [familyPhiExpr_eval,familyGradient,sumThree,derivative,realEval_simplify] using h

/-- Second directional derivative, with the explicit Hessian. -/
theorem familyGradient_segment_deriv (z : ℝ) (p v : FamilyVector) (s : ℝ) (i : Fin 3) :
    HasDerivAt (fun t => familyGradient z (familySegment p v t) i)
      (sumThree (fun j => v j*familyHessian z (familySegment p v s) i j)) s := by
  simpa only [familyGradient,familyHessian,sumThree,derivative,realEval_simplify] using
    (familyPhiExpr.along (familyPartials i)).hasDerivAt_three familyPartials v
      (familyVariables_segment_deriv z p v s)

